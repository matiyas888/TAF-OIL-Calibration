{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/(css|js|images|fonts|build|favicon.ico|robots.txt)(.*)",
